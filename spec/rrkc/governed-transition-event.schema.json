{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://caeluviim.org/schema/rrkc/governed-transition-event.schema.json",
  "title": "RRKC Governed Transition Event",
  "description": "Machine-checkable envelope for a governed state transition. It separates identity, evidence, authorization, veto state, provenance, and replay integrity so that an accepted transition can be audited without conflating truth, authority, and admissibility.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "event_version",
    "operation",
    "subject",
    "actor",
    "pre_state",
    "post_state",
    "admissibility",
    "governance",
    "provenance",
    "integrity"
  ],
  "properties": {
    "event_id": {"type": "string", "pattern": "^[A-Za-z0-9._:-]+$"},
    "event_version": {"const": "0.1.0"},
    "operation": {
      "enum": ["amend", "ratify", "revoke", "delegate", "veto", "suspend", "restore"]
    },
    "subject": {"$ref": "#/$defs/ref"},
    "actor": {"$ref": "#/$defs/ref"},
    "pre_state": {"$ref": "#/$defs/stateRef"},
    "post_state": {"$ref": "#/$defs/stateRef"},
    "evidence": {
      "type": "array",
      "items": {"$ref": "#/$defs/evidenceRef"},
      "uniqueItems": true,
      "default": []
    },
    "admissibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "ruleset", "reasons"],
      "properties": {
        "status": {"enum": ["admissible", "inadmissible", "contested", "undetermined"]},
        "ruleset": {"$ref": "#/$defs/ref"},
        "reasons": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy", "authorization", "vetoes", "blocked"],
      "properties": {
        "policy": {"$ref": "#/$defs/ref"},
        "authorization": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "basis"],
          "properties": {
            "status": {"enum": ["authorized", "unauthorized", "contested", "undetermined"]},
            "basis": {"type": "array", "items": {"$ref": "#/$defs/ref"}}
          }
        },
        "vetoes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["veto_id", "actor", "status", "basis"],
            "properties": {
              "veto_id": {"type": "string", "minLength": 1},
              "actor": {"$ref": "#/$defs/ref"},
              "status": {"enum": ["active", "withdrawn", "overridden", "expired"]},
              "basis": {"type": "string", "minLength": 1}
            }
          }
        },
        "blocked": {"type": "boolean"}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["derived_from", "witnesses", "recorded_at"],
      "properties": {
        "derived_from": {"type": "array", "items": {"$ref": "#/$defs/ref"}},
        "witnesses": {"type": "array", "items": {"$ref": "#/$defs/ref"}},
        "recorded_at": {"type": "string", "format": "date-time"},
        "external_anchor": {"type": "string", "minLength": 1}
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonicalization", "hash_algorithm", "event_hash"],
      "properties": {
        "canonicalization": {"const": "RFC8785"},
        "hash_algorithm": {"enum": ["SHA-256", "SHA-384", "SHA-512"]},
        "prev_hash": {"type": ["string", "null"], "pattern": "^[A-Fa-f0-9]+$"},
        "event_hash": {"type": "string", "pattern": "^[A-Fa-f0-9]+$"}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"governance": {"properties": {"blocked": {"const": true}}}}},
      "then": {
        "properties": {
          "governance": {
            "properties": {
              "vetoes": {
                "contains": {"properties": {"status": {"const": "active"}}, "required": ["status"]}
              }
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"admissibility": {"properties": {"status": {"const": "inadmissible"}}}}},
      "then": {"properties": {"admissibility": {"properties": {"reasons": {"minItems": 1}}}}}
    }
  ],
  "$defs": {
    "ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "kind": {"enum": ["Entity", "Claim", "Evidence", "Relation", "Activity", "Agent", "Policy", "Provenance", "VetoEvent", "State"]},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "stateRef": {
      "allOf": [
        {"$ref": "#/$defs/ref"},
        {"properties": {"kind": {"const": "State"}}}
      ]
    },
    "evidenceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence", "relation", "claim"],
      "properties": {
        "evidence": {"$ref": "#/$defs/ref"},
        "relation": {"enum": ["supports", "rebuts", "contextualizes"]},
        "claim": {"$ref": "#/$defs/ref"}
      }
    }
  }
}
