        "title": "Project content inclusion rule",
        "rule_id": "CAELUVIIM-OPS-CONTENT-INCLUSION-001",
        "version": "1.0.0",
        "status": "effective",
        "determination": "Formal inclusion is reserved for durable attributable status-labeled content that changes constrains evidences validates or operationalizes Caeluviim"
      }
    },
    {
      "id": "urn:caeluviim:rule:architect-confirmation-on-ambiguity",
      "labels": [
        "Rule"
      ],
      "properties": {
        "title": "Architect confirmation required before ambiguous inclusion",
        "status": "effective",
        "trigger": [
          "uncertain project relevance",
          "uncertain durable status",
          "uncertain destination",
          "uncertain canonical status",
          "uncertain architect intent",
          "uncertain sensitivity necessity"
        ],
        "required_action": "Stop formal writes and ask one focused classification question"
      }
    },
    {
      "id": "urn:caeluviim:rule:transient-content-exclusion",
      "labels": [
        "Rule"
      ],
      "properties": {
        "title": "Transient content exclusion rule",
        "status": "effective",
        "excluded_examples": [
          "personal scheduling",
          "temporary usage limits",
          "reset times",
          "generic commentary",
          "operational narration",
          "conversation-only context"
        ]
      }
    },
    {
      "id": "urn:caeluviim:rule:content-classification-correction",
      "labels": [
        "Rule"
      ],
      "properties": {
        "title": "Misclassified content correction procedure",
        "status": "effective",
        "required_actions": [
          "stop downstream consolidation",
          "mark non-canonical",
          "close revert supersede or remove",
          "verify no active dependency remains",
          "report correction and validation"
        ]
      }
    },
