  sicrp:status "evidenced" ;
  sicrp:criterion "mechanism_flow_configuration_fails_declared_obligations_for_affected_constituency" ;
  sicrp:producedByMechanism <urn:caeluviim:mechanism:priority-gate-001> ;
  sicrp:affectsConstituency <urn:caeluviim:constituency:district-households-001> ;
  sicrp:hasMaterialDeficit <urn:caeluviim:deficit:service-hours-001> ;
  sicrp:governedByObligation <urn:caeluviim:obligation:minimum-service-001> ;
  sicrp:hasResourceFlow <urn:caeluviim:flow:service-hours-before> ;
  sicrp:hasExclusionEvent <urn:caeluviim:exclusion:priority-gate-denial-001> ;
