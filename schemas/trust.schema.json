{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://caeluviim.org/schemas/trust.schema.json",
  "title": "Caeluviim Trust Record",
  "type": "object",
  "required": ["record_type", "record_id", "subject_identity_id", "dimension", "scope", "provenance_id", "created_at"],
  "properties": {
    "record_type": { "enum": ["trust_observation", "trust_assessment", "trust_computation", "trust_policy"] },
    "record_id": { "type": "string", "minLength": 3 },
    "subject_identity_id": { "type": "string", "minLength": 3 },
    "dimension": {
      "enum": [
        "provenance_completeness",
        "validation_accuracy",
        "repair_follow_through",
        "constraint_compliance",
        "prediction_resolution",
        "conflict_disclosure",
        "audit_responsiveness"
      ]
    },
    "scope": { "type": "string", "minLength": 1 },
    "value": { "type": "number", "minimum": 0, "maximum": 1 },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "assessor_identity_id": { "type": "string", "minLength": 3 },
    "evidence_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 3 }
    },
    "method": { "type": "string", "minLength": 1 },
    "algorithm_version": { "type": "string", "minLength": 1 },
    "weights": {
      "type": "object",
      "additionalProperties": { "type": "number", "minimum": 0 }
    },
    "included_record_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 3 }
    },
    "excluded_records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["record_id", "reason"],
        "properties": {
          "record_id": { "type": "string", "minLength": 3 },
          "reason": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "contested_by_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 3 }
    },
    "provenance_id": { "type": "string", "minLength": 3 },
    "created_at": { "type": "string", "format": "date-time" },
    "effective_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" }
  },
  "allOf": [
    {
      "if": { "properties": { "record_type": { "const": "trust_observation" } } },
      "then": { "required": ["value", "confidence", "evidence_ids", "method"] }
    },
    {
      "if": { "properties": { "record_type": { "const": "trust_assessment" } } },
      "then": { "required": ["value", "confidence", "assessor_identity_id", "evidence_ids", "method"] }
    },
    {
      "if": { "properties": { "record_type": { "const": "trust_computation" } } },
      "then": { "required": ["value", "confidence", "algorithm_version", "included_record_ids", "weights"] }
    }
  ],
  "additionalProperties": false
}
