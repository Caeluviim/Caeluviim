{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://caeluviim.org/schemas/identity-authority.schema.json",
  "title": "Caeluviim Identity and Authority Record",
  "type": "object",
  "oneOf": [
    { "$ref": "#/$defs/identity" },
    { "$ref": "#/$defs/capability" },
    { "$ref": "#/$defs/delegation" },
    { "$ref": "#/$defs/revocation" }
  ],
  "$defs": {
    "identifier": { "type": "string", "minLength": 3, "pattern": "^[A-Za-z][A-Za-z0-9._:-]+$" },
    "timestamp": { "type": "string", "format": "date-time" },
    "base": {
      "type": "object",
      "required": ["record_type", "record_id", "provenance_id", "created_at"],
      "properties": {
        "record_type": { "type": "string" },
        "record_id": { "$ref": "#/$defs/identifier" },
        "provenance_id": { "$ref": "#/$defs/identifier" },
        "created_at": { "$ref": "#/$defs/timestamp" }
      }
    },
    "identity": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "required": ["identity_id", "identity_type", "status", "key_ids"],
          "properties": {
            "record_type": { "const": "identity" },
            "identity_id": { "$ref": "#/$defs/identifier" },
            "identity_type": { "enum": ["human", "synthetic", "institution", "validator", "observer", "witness", "steward"] },
            "status": { "enum": ["active", "suspended", "revoked", "superseded"] },
            "key_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/identifier" } },
            "controller_identity_id": { "$ref": "#/$defs/identifier" }
          },
          "unevaluatedProperties": false
        }
      ]
    },
    "capability": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "required": ["capability_id", "action_types", "scope"],
          "properties": {
            "record_type": { "const": "capability" },
            "capability_id": { "$ref": "#/$defs/identifier" },
            "action_types": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
            "scope": { "type": "string", "minLength": 1 },
            "allows_subdelegation": { "type": "boolean", "default": false },
            "max_delegation_depth": { "type": "integer", "minimum": 0 }
          },
          "unevaluatedProperties": false
        }
      ]
    },
    "delegation": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "required": ["delegation_id", "grantor_identity_id", "grantee_identity_id", "capability_ids", "authority_basis_id", "scope", "effective_at", "delegation_depth"],
          "properties": {
            "record_type": { "const": "delegation" },
            "delegation_id": { "$ref": "#/$defs/identifier" },
            "grantor_identity_id": { "$ref": "#/$defs/identifier" },
            "grantee_identity_id": { "$ref": "#/$defs/identifier" },
            "capability_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/identifier" } },
            "authority_basis_id": { "$ref": "#/$defs/identifier" },
            "parent_delegation_id": { "$ref": "#/$defs/identifier" },
            "scope": { "type": "string", "minLength": 1 },
            "effective_at": { "$ref": "#/$defs/timestamp" },
            "expires_at": { "$ref": "#/$defs/timestamp" },
            "review_at": { "$ref": "#/$defs/timestamp" },
            "delegation_depth": { "type": "integer", "minimum": 0 }
          },
          "not": { "properties": { "grantor_identity_id": { "const": "" } } },
          "unevaluatedProperties": false
        }
      ]
    },
    "revocation": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "required": ["revocation_id", "target_id", "revoked_by_identity_id", "effective_at", "reason"],
          "properties": {
            "record_type": { "const": "revocation" },
            "revocation_id": { "$ref": "#/$defs/identifier" },
            "target_id": { "$ref": "#/$defs/identifier" },
            "revoked_by_identity_id": { "$ref": "#/$defs/identifier" },
            "effective_at": { "$ref": "#/$defs/timestamp" },
            "reason": { "type": "string", "minLength": 1 }
          },
          "unevaluatedProperties": false
        }
      ]
    }
  }
}
