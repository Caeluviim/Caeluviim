{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://caeluviim.org/schema/source-acquisition-status.schema.json",
  "title": "Caeluviim Source Acquisition Governance Status",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "module_id",
    "module_version",
    "implementation_status",
    "governance_status",
    "proposer_id",
    "independent_validators",
    "required_independent_validator_count",
    "self_ratification_permitted",
    "ratification_claimed",
    "recorded_at",
    "artifact_manifest"
  ],
  "properties": {
    "module_id": {
      "type": "string",
      "format": "uri"
    },
    "module_version": {
      "const": "0.1.0"
    },
    "implementation_status": {
      "const": "implemented"
    },
    "governance_status": {
      "enum": [
        "proposed",
        "validated",
        "ratified"
      ]
    },
    "proposer_id": {
      "type": "string",
      "format": "uri"
    },
    "independent_validators": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "format": "uri"
      }
    },
    "required_independent_validator_count": {
      "type": "integer",
      "minimum": 1
    },
    "self_ratification_permitted": {
      "const": false
    },
    "ratification_claimed": {
      "type": "boolean"
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    },
    "artifact_manifest": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^(?!/)(?!.*\\.\\.)[A-Za-z0-9._/-]+$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "governance_status": {
            "const": "ratified"
          }
        }
      },
      "then": {
        "properties": {
          "ratification_claimed": {
            "const": true
          }
        }
      }
    }
  ]
}
