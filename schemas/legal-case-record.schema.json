{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://caeluviim.org/schemas/legal-case-record.schema.json",
  "title": "Caeluviim Minimum Legal Case Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "case_id",
    "court",
    "caption",
    "jurisdiction_and_venue",
    "parties",
    "facts",
    "causes_of_action",
    "requested_relief",
    "provenance"
  ],
  "properties": {
    "case_id": {"type": "string", "minLength": 1},
    "court": {"type": "string", "minLength": 1},
    "caption": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plaintiff", "defendants"],
      "properties": {
        "plaintiff": {"type": "string", "minLength": 1},
        "defendants": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "jurisdiction_and_venue": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "parties": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "facts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "text", "source_ids"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "text": {"type": "string", "minLength": 1},
          "source_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "causes_of_action": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "authority", "elements", "incorporates"],
        "properties": {
          "title": {"type": "string", "minLength": 1},
          "authority": {"type": "string", "minLength": 1},
          "elements": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "incorporates": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "requested_relief": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_commit", "manifest_id", "generated_at"],
      "properties": {
        "source_commit": {"type": "string", "minLength": 1},
        "manifest_id": {"type": "string", "minLength": 1},
        "generated_at": {"type": "string", "minLength": 1}
      }
    },
    "verification": {"type": "string", "minLength": 1}
  }
}
