    "collective_resolution_claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_id",
        "status",
        "criterion",
        "initiating_claimant_ref",
        "affected_constituency_refs",
        "condition_refs",
        "resolution_plan_refs",
        "before_observation_refs",
        "after_observation_refs",
        "distributional_effect_refs",
        "residual_insolvency_refs",
        "validator_assessment_refs",
        "individual_improvement_only",
        "criteria"
      ],
      "properties": {
        "claim_id": {
          "type": "string",
          "format": "uri"
        },
        "status": {
          "enum": ["proposed", "supported", "validated", "rejected"]
        },
        "criterion": {
          "const": "mechanism_changed_and_effect_generalizes_beyond_initiating_claimant"
        },
        "initiating_claimant_ref": {
          "type": "string",
          "format": "uri"
        },
        "affected_constituency_refs": {
          "$ref": "#/$defs/uri_array"
        },
        "condition_refs": {
          "$ref": "#/$defs/uri_array"
        },
        "resolution_plan_refs": {
          "$ref": "#/$defs/uri_array"
        },
        "before_observation_refs": {
          "$ref": "#/$defs/uri_array"
        },
        "after_observation_refs": {
          "$ref": "#/$defs/uri_array"
        },
        "distributional_effect_refs": {
          "$ref": "#/$defs/uri_array"
        },
        "residual_insolvency_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "uri"
          }
        },
        "validator_assessment_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "uri"
          }
        },
        "individual_improvement_only": {
          "const": false
        },
        "criteria": {
          "$ref": "#/$defs/resolution_criteria"
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generated_by", "generated_at", "content_hash", "source_refs"],
      "properties": {
        "generated_by": {
          "type": "string",
          "format": "uri"
        },
        "generated_at": {
          "type": "string",
          "format": "date-time"
        },
        "content_hash": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "previous_hash": {
          "type": ["string", "null"],
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "source_refs": {
          "$ref": "#/$defs/uri_array"
        }
      }
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proposer_id",
        "validators",
        "status",
        "proposer_is_validator",
        "required_independent_validator_count",
        "ratification_claimed"
      ],
      "properties": {
        "proposer_id": {
          "type": "string",
          "format": "uri"
        },
        "validators": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "uri"
          }
        },
        "status": {
          "enum": ["proposed", "under_validation", "ratified", "rejected"]
        },
        "proposer_is_validator": {
          "const": false
        },
        "required_independent_validator_count": {
          "const": 2
        },
        "ratification_claimed": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "ratified"
              }
            }
          },
          "then": {
            "properties": {
              "validators": {
                "minItems": 2
              },
              "ratification_claimed": {
                "const": true
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "ratification_claimed": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "status": {
                "const": "ratified"
              },
              "validators": {
                "minItems": 2
              }
            }
          }
        }
      ]
    }
  }
}
