        "decision",
        "assessed_at",
        "independent_from_proposer",
        "independent_from_implementers",
        "evidence_refs"
      ],
      "properties": {
        "assessment_id": {
          "type": "string",
          "format": "uri"
        },
        "validator_ref": {
          "type": "string",
          "format": "uri"
        },
        "assessment_scope": {
          "enum": ["structural_insolvency_condition", "collective_resolution_plan", "collective_resolution_claim"]
        },
