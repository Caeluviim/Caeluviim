        },
        "metric_ref": {
          "type": "string",
          "format": "uri"
        },
        "constituency_ref": {
          "type": "string",
          "format": "uri"
        },
        "initiating_observation_ref": {
          "type": "string",
          "format": "uri"
        },
        "non_initiating_observation_refs": {
          "$ref": "#/$defs/uri_array"
        },
        "coverage_count": {
          "type": "integer",
          "minimum": 2
        },
        "coverage_unit": {
          "type": "string",
          "minLength": 1
        },
        "generalized_beyond_initiating_claimant": {
          "type": "boolean"
        },
        "non_regression_passed": {
          "type": "boolean"
        },
        "evidence_refs": {
          "$ref": "#/$defs/uri_array"
        }
      }
    },
    "validator_assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
