{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://caeluviim.org/schema/evidence-intake-status.schema.json",
  "title": "Evidence Intake Pipeline Implementation and Governance Status",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "module_id",
    "module_version",
    "implementation_status",
    "governance_status",
    "proposer_id",
    "independent_validators",
    "required_independent_validator_count",
    "self_ratification_permitted",
    "ratification_claimed",
    "recorded_at",
    "artifact_manifest"
  ],
  "properties": {
    "module_id": {
      "const": "urn:caeluviim:module:evidence-intake"
    },
    "module_version": {
      "const": "0.1.0"
    },
    "implementation_status": {
      "const": "implemented"
    },
    "governance_status": {
      "enum": [
        "proposed",
        "under_validation",
        "ratified",
        "rejected"
      ]
    },
    "proposer_id": {
      "type": "string",
      "format": "uri"
    },
    "independent_validators": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "format": "uri"
      }
    },
    "required_independent_validator_count": {
      "const": 2
    },
    "self_ratification_permitted": {
      "const": false
    },
    "ratification_claimed": {
      "type": "boolean"
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    },
    "artifact_manifest": {
      "type": "array",
      "minItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^(README\\.md$|(docs|schemas|ontology|shapes|examples|src|scripts|queries|tests|\\.github)/)"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "governance_status": {
            "const": "ratified"
          }
        },
        "required": [
          "governance_status"
        ]
      },
      "then": {
        "properties": {
          "independent_validators": {
            "minItems": 2
          },
          "ratification_claimed": {
            "const": true
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "ratification_claimed": {
            "const": true
          }
        },
        "required": [
          "ratification_claimed"
        ]
      },
      "then": {
        "properties": {
          "governance_status": {
            "const": "ratified"
          },
          "independent_validators": {
            "minItems": 2
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "governance_status": {
            "enum": [
              "proposed",
              "under_validation"
            ]
          }
        },
        "required": [
          "governance_status"
        ]
      },
      "then": {
        "properties": {
          "ratification_claimed": {
            "const": false
          }
        }
      }
    }
  ]
}
