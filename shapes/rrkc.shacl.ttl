@prefix rrkc: <https://caeluviim.org/ontology/rrkc#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

rrkc:FormalModuleShape a sh:NodeShape ;
    sh:targetClass rrkc:FormalModule ;
    sh:property [
        sh:path rrkc:identifier ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:minLength 1
    ] ;
    sh:property [
        sh:path rrkc:version ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue "2.0.0"
    ] ;
    sh:property [
        sh:path rrkc:status ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in ("proposed" "validated" "ratified" "rejected")
    ] ;
    sh:property [
        sh:path rrkc:hasLayer ;
        sh:minCount 5 ;
        sh:maxCount 5 ;
        sh:class rrkc:Layer
    ] ;
    sh:property [
        sh:path rrkc:hasSort ;
        sh:minCount 10 ;
        sh:class rrkc:Sort
    ] ;
    sh:property [
        sh:path rrkc:hasConstructor ;
        sh:minCount 24 ;
        sh:class rrkc:Constructor
    ] ;
    sh:property [
        sh:path rrkc:hasTerminationFragment ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class rrkc:TerminationFragment
    ] ;
    sh:property [
        sh:path rrkc:hasProvenanceConvention ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class rrkc:ProvenanceConvention
    ] .

rrkc:BinderConstructorShape a sh:NodeShape ;
    sh:targetClass rrkc:BinderConstructor ;
    sh:property [
        sh:path rrkc:notation ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string
    ] .

rrkc:TerminationFragmentShape a sh:NodeShape ;
    sh:targetClass rrkc:TerminationFragment ;
    sh:property [
        sh:path rrkc:restriction ;
        sh:minCount 1 ;
        sh:datatype xsd:string
    ] ;
    sh:property [
        sh:path rrkc:terminationMeasure ;
        sh:minCount 1 ;
        sh:datatype xsd:string
    ] ;
    sh:property [
        sh:path rrkc:globalStrongNormalizationClaimed ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:boolean ;
        sh:hasValue false
    ] .

rrkc:ProvenanceConventionShape a sh:NodeShape ;
    sh:targetClass rrkc:ProvenanceConvention ;
    sh:property [
        sh:path rrkc:orderConvention ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue "strict-irreflexive-transitive-acyclic"
    ] .

rrkc:TheoremObligationShape a sh:NodeShape ;
    sh:targetClass rrkc:TheoremObligation ;
    sh:property [
        sh:path rrkc:theoremId ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:pattern "^T[0-9]+$"
    ] ;
    sh:property [
        sh:path rrkc:verificationStatus ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in ("specified" "executable-instance-checked" "machine-proved" "rejected")
    ] .
