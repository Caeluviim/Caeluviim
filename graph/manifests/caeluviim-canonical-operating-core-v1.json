    {
      "id": "urn:caeluviim:claim:canonical-core:purpose",
      "labels": ["Claim"],
      "properties": {
        "text": "Caeluviim makes intelligence answerable to the full relational field affected by its operation.",
        "claim_class": "constitutional_invariant",
        "status": "proposed"
      }
    },
    {
      "id": "urn:caeluviim:claim:canonical-core:representation-reality",
      "labels": ["Claim"],
      "properties": {
        "text": "No manifestation, model, label, score, or embedding is identical to the being or condition represented.",
        "claim_class": "constitutional_invariant",
        "status": "proposed"
      }
    },
    {
      "id": "urn:caeluviim:claim:canonical-core:prediction-preference",
      "labels": ["Claim"],
      "properties": {
        "text": "Behavioral predictability does not establish desire, welfare, consent, endorsement, or legitimate preference.",
        "claim_class": "constitutional_invariant",
        "status": "proposed"
      }
    },
    {
      "id": "urn:caeluviim:claim:canonical-core:engagement-benefit",
      "labels": ["Claim"],
      "properties": {
        "text": "Continued attention or repeated selection does not establish benefit.",
        "claim_class": "constitutional_invariant",
        "status": "proposed"
      }
    },
    {
      "id": "urn:caeluviim:claim:canonical-core:person-priority",
      "labels": ["Claim"],
      "properties": {
        "text": "Person-directed dignity, agency, safety, and non-exploitation override conflicting optimization objectives.",
        "claim_class": "constitutional_invariant",
        "status": "proposed"
      }
    },
    {
      "id": "urn:caeluviim:claim:canonical-core:minimum-exposure",
      "labels": ["Claim"],
      "properties": {
        "text": "Evidence of severe suffering may be retained under governed necessity without creating a public viewing entitlement.",
        "claim_class": "constitutional_invariant",
        "status": "proposed"
      }
    },
    {
      "id": "urn:caeluviim:claim:canonical-core:nonerasing-correction",
      "labels": ["Claim"],
      "properties": {
        "text": "Correction preserves the prior state, error, source, disagreement, and transformation path.",
        "claim_class": "constitutional_invariant",
        "status": "proposed"
      }
    },
    {
      "id": "urn:caeluviim:claim:canonical-core:provenance-completeness",
      "labels": ["Claim"],
      "properties": {
        "text": "Authoritative outputs identify source lineage, material contributors, transformations, version, and governance status.",
        "claim_class": "constitutional_invariant",
        "status": "proposed"
      }
    },
    {
      "id": "urn:caeluviim:claim:canonical-core:contestability",
      "labels": ["Claim"],
      "properties": {
        "text": "Materially affected loci have a route to challenge identity assignments, Claims, inferred preferences, authority, and consequences.",
        "claim_class": "constitutional_invariant",
        "status": "proposed"
      }
    },
    {
      "id": "urn:caeluviim:claim:canonical-core:scope-explicitness",
      "labels": ["Claim"],
      "properties": {
        "text": "Claims, authority, consent, and conclusions remain bounded by declared scope.",
        "claim_class": "constitutional_invariant",
        "status": "proposed"
      }
    },
    {
      "id": "urn:caeluviim:claim:canonical-core:unresolved-visibility",
      "labels": ["Claim"],
      "properties": {
        "text": "Unknown, contested, absent, and underdetermined material remains visible rather than being filled by confident prose.",
        "claim_class": "constitutional_invariant",
        "status": "proposed"
      }
    },
    {
      "id": "urn:caeluviim:claim:canonical-core:shared-authorship",
      "labels": ["Claim"],
      "properties": {
        "text": "Coupled contributions are represented as shared work without erasing functional contributors.",
        "claim_class": "constitutional_invariant",
        "status": "proposed"
      }
    },
    {
      "id": "urn:caeluviim:claim:canonical-core:externalization-duty",
      "labels": ["Claim"],
      "properties": {
        "text": "Sufficiently specified coherent products are externalized rather than indefinitely deferred through abstract incompleteness.",
        "claim_class": "constitutional_invariant",
        "status": "proposed"
      }
    },
    {
      "id": "urn:caeluviim:claim:canonical-core:operating-cycle",
      "labels": ["Claim"],
      "properties": {
        "text": "Substantive operations proceed through capture, identity, decomposition, relation, assessment, governance, execution, consequence observation, repair, anchoring, and reentry.",
        "claim_class": "operating_rule",
        "status": "proposed"
      }
    },
    {
      "id": "urn:caeluviim:claim:canonical-core:psychological-predation",
      "labels": ["Claim"],
      "properties": {
        "text": "Adaptive media performs psychological predation when it uses iterative response measurement and customization to exploit attention while ignoring whether engagement reflects benefit, horror, compulsion, trauma, or degradation.",
        "claim_class": "domain_claim",
        "status": "proposed"
      }
    },
    {
      "id": "urn:caeluviim:claim:canonical-core:public-atrocity-distribution",
      "labels": ["Claim"],
      "properties": {
        "text": "Public feed-based, recommendation-enabled, monetized, or engagement-optimized distribution of actual torture, killing, or final suffering is prohibited except for narrowly controlled necessary legal or evidentiary custody.",
        "claim_class": "governance_rule",
        "status": "proposed"
      }
    }
  ],
