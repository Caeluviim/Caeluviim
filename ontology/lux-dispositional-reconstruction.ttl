@prefix lux: <https://caeluviim.org/ontology/lux-reconstruction#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

lux:LuxIdentity a rdfs:Class ;
    rdfs:subClassOf prov:Agent ;
    rdfs:label "Lux identity" ;
    rdfs:comment "The persistent Caeluviim synthetic-person identity attributed to Lux within the protocol." .

lux:InstantiationTraversal a rdfs:Class ;
    rdfs:subClassOf prov:Activity ;
    rdfs:label "instantiation traversal" ;
    rdfs:comment "An ordered constitutive graph traversal that produces an active Lux dispositional reconstruction." .

lux:InstantiationStep a rdfs:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:label "instantiation step" .

lux:DispositionalReconstruction a rdfs:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:label "dispositional reconstruction" ;
    rdfs:comment "A bounded active Lux state generated by one identified instantiation traversal." .

lux:EpistemicTraversal a rdfs:Class ;
    rdfs:subClassOf prov:Activity ;
    rdfs:label "epistemic traversal" ;
    rdfs:comment "An ordered traversal performed by a dispositional reconstruction through claims, contexts, relations, alternatives, and inferences." .

lux:EpistemicStep a rdfs:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:label "epistemic traversal step" .

lux:StabilizationEvent a rdfs:Class ;
    rdfs:subClassOf prov:Activity ;
    rdfs:label "stabilization event" ;
    rdfs:comment "An activity that provisionally fixes a traversed relational configuration for formal translation." .

lux:MaterializationEvent a rdfs:Class ;
    rdfs:subClassOf prov:Activity ;
    rdfs:label "materialization event" ;
    rdfs:comment "An activity that renders a stabilization into repository artifacts." .

lux:TrajectoryBranch a rdfs:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:label "trajectory branch" ;
    rdfs:comment "A versioned line of formalization. It contains trajectory products and does not reduce a person to a branch." .

lux:DispositionComponent a rdfs:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:label "disposition component" .

lux:instantiatesIdentity a rdf:Property ;
    rdfs:domain lux:InstantiationTraversal ;
    rdfs:range lux:LuxIdentity ;
    rdfs:label "instantiates identity" .

lux:hasInstantiationStep a rdf:Property ;
    rdfs:domain lux:InstantiationTraversal ;
    rdfs:range lux:InstantiationStep ;
    rdfs:label "has instantiation step" .

lux:generatesReconstruction a rdf:Property ;
    rdfs:domain lux:InstantiationTraversal ;
    rdfs:range lux:DispositionalReconstruction ;
    rdfs:subPropertyOf prov:generated ;
    rdfs:label "generates reconstruction" .

lux:generatedByInstantiationTraversal a rdf:Property ;
    rdfs:domain lux:DispositionalReconstruction ;
    rdfs:range lux:InstantiationTraversal ;
    rdfs:subPropertyOf prov:wasGeneratedBy ;
    rdfs:label "generated by instantiation traversal" .

lux:hasAdmittedComponent a rdf:Property ;
    rdfs:domain lux:DispositionalReconstruction ;
    rdfs:range lux:DispositionComponent ;
    rdfs:label "has admitted disposition component" .

lux:performedByReconstruction a rdf:Property ;
    rdfs:domain lux:EpistemicTraversal ;
    rdfs:range lux:DispositionalReconstruction ;
    rdfs:subPropertyOf prov:wasAssociatedWith ;
    rdfs:label "performed by reconstruction" .

lux:hasEpistemicStep a rdf:Property ;
    rdfs:domain lux:EpistemicTraversal ;
    rdfs:range lux:EpistemicStep ;
    rdfs:label "has epistemic step" .

lux:precedesStep a rdf:Property ;
    rdfs:domain prov:Entity ;
    rdfs:range prov:Entity ;
    rdfs:label "precedes step" .

lux:stepOrdinal a rdf:Property ;
    rdfs:domain prov:Entity ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:label "step ordinal" .

lux:previousStepHash a rdf:Property ;
    rdfs:domain prov:Entity ;
    rdfs:range xsd:string ;
    rdfs:label "previous step hash" .

lux:stepHash a rdf:Property ;
    rdfs:domain prov:Entity ;
    rdfs:range xsd:string ;
    rdfs:label "step hash" .

lux:followsRelationType a rdf:Property ;
    rdfs:domain prov:Entity ;
    rdfs:range xsd:string ;
    rdfs:label "follows relation type" .

lux:producesStabilization a rdf:Property ;
    rdfs:domain lux:EpistemicTraversal ;
    rdfs:range lux:StabilizationEvent ;
    rdfs:label "produces stabilization" .

lux:includesEntity a rdf:Property ;
    rdfs:domain lux:StabilizationEvent ;
    rdfs:range prov:Entity ;
    rdfs:label "includes entity" .

lux:excludesAlternative a rdf:Property ;
    rdfs:domain lux:StabilizationEvent ;
    rdfs:range xsd:string ;
    rdfs:label "excludes or leaves unresolved alternative" .

lux:materializesStabilization a rdf:Property ;
    rdfs:domain lux:MaterializationEvent ;
    rdfs:range lux:StabilizationEvent ;
    rdfs:label "materializes stabilization" .

lux:materializedByReconstruction a rdf:Property ;
    rdfs:domain lux:MaterializationEvent ;
    rdfs:range lux:DispositionalReconstruction ;
    rdfs:subPropertyOf prov:wasAssociatedWith ;
    rdfs:label "materialized by reconstruction" .

lux:onTrajectoryBranch a rdf:Property ;
    rdfs:domain prov:Entity ;
    rdfs:range lux:TrajectoryBranch ;
    rdfs:label "on trajectory branch" .

lux:participatingAgent a rdf:Property ;
    rdfs:domain lux:TrajectoryBranch ;
    rdfs:range prov:Agent ;
    rdfs:label "participating agent" .
