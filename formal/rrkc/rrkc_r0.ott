% RRKC R2 — Ott source of truth for the closed R0/RE/RR surface.
% Status: proposed. Every binder and signature dependency is explicit.

metavars
  x, y :: xvar
  a, v, r, sigma, n :: atom
  i, j :: nat

grammar
  tau :: 'tau_' ::=                         {{ com Sorts }}
    | Entity
    | Claim
    | Evidence
    | Relation
    | Activity
    | Agent
    | Policy
    | Provenance
    | Prop
    | Code tau
    | tau -> tau

  e :: 'e_' ::=                             {{ com Terms }}
    | x
    | id ( a )
    | claim ( e )
    | evidence ( e )
    | rel ( r , e , e )
    | act ( sigma , es )
    | stamp ( e , e )
    | revise ( e , e )
    | e @ v
    | lambda x : tau . e                     {{ bind x in e }}
    | e e
    | let x : tau = e in e                   {{ bind x in e }}
    | quote ( e )
    | decode ( e )
    | eval ( e )

  es :: 'es_' ::=                           {{ com Term vectors }}
    | nil
    | e :: es

  phi :: 'phi_' ::=                         {{ com Propositions }}
    | top
    | bottom
    | not phi
    | phi and phi
    | phi or phi
    | phi implies phi
    | forall x : tau . phi                   {{ bind x in phi }}
    | exists x : tau . phi                   {{ bind x in phi }}
    | e = e
    | supports ( e , e )
    | rebuts ( e , e )
    | admissible ( e )
    | derivedFrom ( e , e )

  G :: 'G_' ::=                             {{ com Typing contexts }}
    | empty
    | G , x : tau

  GG :: 'GG_' ::=                           {{ com Governance states }}
    | gov ( policies , roles , delegation , vetoes )

  out :: 'out_' ::=                         {{ com Progress outcomes }}
    | value ( e )
    | reduced ( e )
    | blocked ( e )

relations
  wf :: G * e
  typing :: G * e * tau
  propwf :: G * phi
  defeq :: G * e * e * tau
  step :: G * GG * e * e
  gprogress :: G * GG * e * out
  admits :: GG * e
  precedes :: e * e * e
  derived :: e * e * e

relation wf: G |- e wf
relation typing: G |- e : tau
relation propwf: G |- phi prop
relation defeq: G |- e = e : tau
relation step: G ; GG |- e --> e
relation gprogress: G ; GG |- e ==> out
relation admits: GG |- e admissible
relation precedes: e |- e prec e
relation derived: e |- e derivedFrom e

rules

  G |- x : tau
  -------------------------- :: Var
  G, x : tau |- x : tau

  -------------------------- :: Id
  G |- id(a) : Entity

  G |- e : Claim
  -------------------------- :: ClaimEntity
  G |- claim(e) : Entity

  G |- e : Evidence
  -------------------------- :: EvidenceEntity
  G |- evidence(e) : Entity

  G |- e1 : tau1
  G |- e2 : tau2
  relation_profile(r) = (tau1,tau2)
  -------------------------- :: Relation
  G |- rel(r,e1,e2) : Relation

  G |- es : taus
  operation_profile(sigma) = (taus,tau)
  -------------------------- :: Activity
  G |- act(sigma,es) : tau

  G |- e : tau
  G |- pi : Provenance
  -------------------------- :: Stamp
  G |- stamp(e,pi) : tau

  G |- e1 : tau
  G |- e2 : tau
  -------------------------- :: Revise
  G |- revise(e1,e2) : tau

  G |- e : tau
  -------------------------- :: Version
  G |- e@v : tau

  G, x:tau1 |- e : tau2
  -------------------------- :: Lambda
  G |- lambda x:tau1.e : tau1 -> tau2

  G |- e1 : tau1 -> tau2
  G |- e2 : tau1
  -------------------------- :: Application
  G |- e1 e2 : tau2

  G |- e1 : tau1
  G, x:tau1 |- e2 : tau2
  -------------------------- :: Let
  G |- let x:tau1=e1 in e2 : tau2

  G |- e : tau
  -------------------------- :: Quote
  G |- quote(e) : Code tau

  G |- c : Code tau
  canonical(c)
  -------------------------- :: Decode
  G |- decode(c) : tau

  G |- c : Code tau
  -------------------------- :: Eval
  G |- eval(c) : tau

  G |- e2 : tau1
  G, x:tau1 |- e1 : tau2
  -------------------------- :: Beta
  G ; GG |- (lambda x:tau1.e1) e2 --> e1[e2/x]

  G |- e1 : tau1
  G, x:tau1 |- e2 : tau2
  -------------------------- :: LetStep
  G ; GG |- let x:tau1=e1 in e2 --> e2[e1/x]

  G |- e : tau
  -------------------------- :: EvalQuote
  G ; GG |- eval(quote(e)) --> e

  G |- e1 : tau
  G |- e2 : tau
  GG |- revise(e1,e2) admissible
  -------------------------- :: GovernedRevision
  G ; GG |- revise(e1,e2) --> e2

  G |- e1 : tau
  G |- e2 : tau
  not (GG |- revise(e1,e2) admissible)
  -------------------------- :: BlockedRevision
  G ; GG |- revise(e1,e2) ==> blocked(revise(e1,e2))

substitutions
  single e2 x e1 :: e1[e2/x]
