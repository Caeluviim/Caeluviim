NEO4J_URI=neo4j://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=replace-with-a-strong-local-password
NEO4J_DATABASE=neo4j

# Laptop-local host ports. Change these only if another service already uses them.
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687

# Conservative defaults for an ordinary laptop. Raise only when the corpus requires it.
NEO4J_HEAP_INITIAL=512m
NEO4J_HEAP_MAX=1G
NEO4J_PAGECACHE=512m
